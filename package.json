{
  "name": "wya-im",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --local --config wrangler.local.jsonc --persist-to .wrangler/state",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{app,lib,db,deployment,scripts,tests}/**/*.{ts,tsx,mts,mjs,css}\" \"*.{ts,mts,mjs}\"",
    "format:check": "prettier --check \"{app,lib,db,deployment,scripts,tests}/**/*.{ts,tsx,mts,mjs,css}\" \"*.{ts,mts,mjs}\""
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@better-auth/mcp": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "@giphy/js-fetch-api": "5.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-bubble-menu": "^3.32.0",
    "@tiptap/extension-code": "^3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-drag-handle": "3.32.0",
    "@tiptap/extension-drag-handle-react": "3.32.0",
    "@tiptap/extension-floating-menu": "^3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-node-range": "3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@tiptap/y-tiptap": "3.0.7",
    "better-auth": "1.7.10",
    "big.js": "^7.0.1",
    "drizzle-orm": "0.45.2",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "next": "16.4.2",
    "posthog-js": "^1.438.12",
    "prosemirror-codemark": "0.4.2",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "recharts": "^3.8.0",
    "remark-directive": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "shiki": "4.5.0",
    "simple-icons": "16.35.0",
    "unified": "^11.0.5",
    "y-protocols": "1.0.6",
    "yjs": "13.6.27",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/big.js": "^7.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "jose": "6.2.12",
    "prettier": "3.9.10",
    "react-server-dom-webpack": "19.3.1",
    "typescript": "5.9.3",
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    },
    "fflate": "0.7.5"
  }
}
